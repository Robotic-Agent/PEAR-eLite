---
import Shell from './Shell.astro'
import Contents from '../components/Contents.astro'
import type { MarkdownHeading } from 'astro'
import 'katex/dist/katex.min.css'

interface Props {
  title: string
  description: string
  section: 'recipes' | 'results'
  kicker: string
  headings: MarkdownHeading[]
}
const { title, description, section, kicker, headings } = Astro.props
---
<Shell {title} {description} {section}>
  <header class="doc-header"><p class="eyebrow">{kicker}</p><h1>{title}</h1><p>{description}</p></header>
  <div class="doc-grid">
    <article class="prose"><slot /></article>
    <Contents {headings} />
  </div>
</Shell>
