# shellcheck shell=bash
# The slime / SGLang / Megatron environment: every version pinned. Follows slime's docker/Dockerfile at SLIME_COMMIT
# (SGLang v0.5.21 line), with the CUDA extensions built for Hopper, datacenter Blackwell and RTX 5090.

SLIME_COMMIT=79aa41a884ab0bf65222c94418f6357d3c31192b
SLIME_PATCH_VERSION=v0.5.21

PREFIX=${PREFIX:-/opt/slime}          # env/, src/ and bin/ live here; the runtime tar unpacks to the same path
PYTHON_VERSION=3.12.15
UV_VERSION=0.12.24
UV_SHA256_x86_64=b4dfaef47d491a7296981f8374a4595f55dbf84e8937c8ecd2983574d8bb3da6

# CUDA 13 (driver >= 580): the toolkit comes from the nvidia-*-cu13 wheels into the environment
CUDA_TAG=cu130
CUDA_ARCHS=${CUDA_ARCHS:-"9.0;10.0;12.0"}           # H100, B200, RTX 5090 (add 8.0 for A100)
NVTE_CUDA_ARCHS=${NVTE_CUDA_ARCHS:-"90;100f;120f"}  # TE: Blackwell family suffix, needs CMake >= 4

TORCH_VERSION=2.13.0                  # sglang 0.5.21 pins these
TORCHAUDIO_VERSION=2.11.0
TORCHVISION_VERSION=0.28.0             # the torchvision release for torch 2.13
# the CUDA compiler wheels matching torch's CUDA runtime (torch cu130 requires cuda-toolkit==13.0.3, whose extras pin
# these); the driver must support CUDA 13.0, and the compiler must not be newer than the runtime the extensions load
CUDA_TOOLKIT_VERSION=13.0.3.0
CUDA_NVCC_VERSION=13.0.88              # nvidia-cuda-nvcc, -crt, nvidia-nvvm, nvidia-nvjitlink
CUDA_CCCL_VERSION=13.0.85              # nvidia-cuda-cccl, -profiler-api
RUST_VERSION=1.92                     # sglang/rust/rust-toolchain.toml; the Rust extensions build at install time
TRANSFORMERS_VERSION=5.12.1
SGLANG_VERSION=0.5.21
SGLANG_KERNEL_VERSION=0.4.7
FLASHINFER_VERSION=0.6.18

TRANSFORMER_ENGINE_VERSION=2.18.0
MEGATRON_COMMIT=ae76c60e6c35d913867d6dd7bad0f30b128b54e7
APEX_COMMIT=10417aceddd7d5d05d7cbf7b0fc2daad1105f8b4
TMS_COMMIT=bdab8c55f490a00a746ec34e301391617f5ca878
MAMBA_COMMIT=0048fbf2e7b2f214dcbe703ea3dec2b9647595e1
CAUSAL_CONV1D_VERSION=1.5.3.post1
FLA_VERSION=0.5.2
TILELANG_VERSION=0.1.12
NVIDIA_RESILIENCY_EXT_VERSION=0.7.0
NCCL_VERSION=2.30.7
NVTX_COMMIT=v3.1.0
SGL_ROUTER_WHEEL_URL=https://github.com/zhuzilin/sgl-router/releases/download/v0.3.2-9daabcd/sglang_router-0.3.2-cp38-abi3-manylinux_2_28_x86_64.whl

NUMPY_VERSION=2.3.5
SCIPY_VERSION=1.18.1
PYARROW_VERSION=25.0.1
